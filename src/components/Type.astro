---
import { typeName, typeColor, url } from '../lib/game';
interface Props { t: string; link?: boolean }
const { t, link = true } = Astro.props;
const c = typeColor(t);
// 亮色屬性（電、冰、地面…）改用深色字，維持對比
const [r, g, b] = [1, 3, 5].map(i => parseInt(c.slice(i, i + 2), 16) / 255).map(v => (v <= 0.03928 ? v / 12.92 : ((v + 0.055) / 1.055) ** 2.4));
const dark = 0.2126 * r + 0.7152 * g + 0.0722 * b > 0.36;
const Tag = link ? 'a' : 'span';
---
<Tag class:list={['type', { 'dark-text': dark }]} style={`--t:${c}`} href={link ? url(`/types/#${t}`) : undefined}>{typeName(t)}</Tag>
