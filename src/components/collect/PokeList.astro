---
// 寶可夢小清單：動畫小圖（Sprite，只在畫面內播放）、No.、中文名，連到圖鑑頁。
import Sprite from '../Sprite.astro';
import { thumbScale } from './thumb';
import { pad, url, type Pokemon } from '../../lib/game';
interface Props { list: Pokemon[] }
const { list } = Astro.props;
---
<ul class="pl">
  {list.map(p => (
    <li>
      <a href={url(`/pokemon/${p.dex}/`)}>
        <span class="th"><Sprite dex={p.dex} scale={thumbScale(p)} /></span>
        <span class="nm"><small class="num">No.{pad(p.dex)}</small>{p.zh}</span>
      </a>
    </li>
  ))}
</ul>

<style>
  .pl { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(176px, 1fr)); border-top: 1px solid var(--rule); }
  .pl a { display: flex; align-items: center; gap: 8px; padding: 4px 6px 4px 0; text-decoration: none; border-bottom: 1px solid var(--rule); font-size: 14px; font-weight: 700; }
  .pl a:hover { background: var(--ch-tint); }
  .th { width: 56px; height: 56px; display: grid; place-items: center; overflow: hidden; flex: none; }
  .nm small { display: block; font-size: 11.5px; color: var(--ink-3); font-weight: 600; }
</style>
