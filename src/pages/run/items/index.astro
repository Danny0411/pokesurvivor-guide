---
import RunPage from '../../../components/run/RunPage.astro';
import ITEMS from '../../../data/game/Items.json';
import ZH from '../../../i18n/zh/run.json';

// 西文名取自 Items.json；英文名取自遊戲內建的英文譯名表（.cache/）
const EN: Record<string, string> = {
  leftovers: 'Leftovers', choiceband: 'Choice Band', quickclaw: 'Quick Claw', focussash: 'Focus Sash',
  shellbell: 'Shell Bell', amuletcoin: 'Amulet Coin', luckyegg: 'Lucky Egg', lifeorb: 'Life Orb',
  choicescarf: 'Choice Scarf', rockyhelmet: 'Rocky Helmet', assaultvest: 'Assault Vest',
};
// 確切數值與來源行號（.cache/app.pretty.js）
const EXACT: Record<string, { exact: string; src: string }> = {
  leftovers: { exact: '每秒回復 1.5% 最大生命。以裝備當下的最大生命計算，之後不更新。', src: '83370–83378' },
  choiceband: { exact: '攻擊倍率 ×1.4。無法切換招式組。', src: '83380–83388、87940' },
  quickclaw: { exact: '所有招式的冷卻 ×0.8（即 −20%）。', src: '83390–83398' },
  focussash: { exact: '致命傷害改為保留 1 點生命，並無敵 1.2 秒。每 60 秒（瀏覽器真實時間）最多觸發一次。', src: '83400–83404、87882、88032' },
  shellbell: { exact: '造成傷害的 4% 累積為待回復生命，待回復上限 4 點；每秒最多回復 4 點。', src: '83406–83410、88058、88078–88080' },
  amuletcoin: { exact: '本局結束時寶可幣 ×1.5。', src: '83412–83420、95075' },
  luckyegg: { exact: '經驗倍率 ×1.3。', src: '83422–83430' },
  lifeorb: { exact: '攻擊倍率 ×1.3。每次施放招式扣最大生命的 1%（至少 1 點），生命不會因此低於 1；環繞類與拖尾類招式不扣。', src: '83432–83440、87984' },
  choicescarf: { exact: '移動速度 ×1.35。', src: '83442–83450' },
  rockyhelmet: { exact: '敵人以接觸攻擊碰到你時，該敵人受到 15 + 4 × 等級 點傷害。同一敵人每 0.55 秒最多觸發一次。', src: '83452–83456、88677–88678' },
  assaultvest: { exact: '減傷 +0.2（即 +20%）。所有減傷來源合計上限 80%。', src: '83458–83466、87901' },
};
const ROWS = ITEMS.LIST.map(i => ({ id: i.id, es: i.name, zh: ZH.items[i.id].name, desc: ZH.items[i.id].desc, en: EN[i.id], ...EXACT[i.id] }));
const TOC = [
  { id: 'source', text: '取得方式' },
  { id: 'list', text: '十一種道具' },
  { id: 'rules', text: '持有與替換' },
];
---
<RunPage title="持有物" summary="局內同一時間只能持有 1 件道具，共 11 種。每種的效果與確切數值依遊戲程式碼整理。" toc={TOC}>
  <h2 id="source">取得方式</h2>
  <div class="spec-wrap">
    <table class="spec">
      <thead><tr><th>來源</th><th>機率</th><th>說明</th></tr></thead>
      <tbody>
        <tr><th>首領擊倒</th><td class="num">必掉 1 件</td><td>一般首領與裂隙傳說首領都會掉落。</td></tr>
        <tr><th>小寶箱</th><td class="num">8%</td><td>破壞小寶箱時判定一次。</td></tr>
        <tr><th>大寶箱</th><td class="num">50%</td><td>開啟大寶箱時判定一次。</td></tr>
        <tr><th>其他來源</th><td>—</td><td>遊戲中只有以上三處會產生道具拾取物，一般敵人、草叢、岩石不掉道具。</td></tr>
      </tbody>
    </table>
  </div>
  <p>11 種道具的機率相同，抽取時每種約 9.1%（1 ÷ 11）。抽取不排除目前持有的道具。</p>

  <h2 id="list">十一種道具</h2>
  <div class="spec-wrap">
    <table class="spec items">
      <thead><tr><th>道具</th><th>效果</th><th>確切數值</th></tr></thead>
      <tbody>
        {ROWS.map(r => (
          <tr>
            <th>
              <span class="nm">{r.zh}</span>
              <small class="alt">{r.en}<span class="sep">／</span>{r.es}</small>
            </th>
            <td>{r.desc}</td>
            <td>{r.exact}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="fine">表中每項的上方是中文名，下方依序為遊戲內建的英文譯名與西文原名。</p>

  <h2 id="rules">持有與替換</h2>
  <ul>
    <li>同時只能持有 1 件。撿到與目前相同的道具時不會變動，畫面顯示「已持有」。</li>
    <li>撿到不同的道具時，會出現兩張卡：「Quedarme con」（保留目前的道具）與「Cambiar a」（換成新道具）。選定後，另一件會被丟棄。</li>
    <li>換裝時先卸下舊道具的效果，再套用新道具的效果。</li>
    <li>道具只作用於拾取它的本機玩家。</li>
    <li>氣勢披帶的計時以瀏覽器的 <code>performance.now()</code> 為準，初值為 −999，所以頁面載入後約 59 秒內不會觸發；之後每 60 秒最多觸發一次。</li>
    <li>吃剩的東西的回復量以裝備當下的最大生命計算，之後不隨最大生命變動。生命寶珠的扣血發生在每次施放招式時。</li>
  </ul>
</RunPage>

<style>
  .nm { font-weight: 900; font-size: 15px; }
  .alt { display: block; font-weight: 500; font-size: 12px; color: var(--ink-3); white-space: normal; margin-top: 2px; }
  .sep { margin: 0 4px; }
  .src-col { font-size: 12.5px; color: var(--ink-3); white-space: nowrap; }
  .items td:nth-child(2) { min-width: 14em; }
  .items td:nth-child(3) { min-width: 22em; }
  .fine { font-size: 12.5px; color: var(--ink-3); }
</style>
