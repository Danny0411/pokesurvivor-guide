---
// 更新紀錄：時間軸，新的在上。內容來自 src/i18n/zh/meta.json 的 changelog，
// 對應 src/data/game/CHANGELOG.json（條目數與各分項數已核對一致）。來源沒有版本號欄位，以日期標示。
import Base from '../../layouts/Base.astro';
import ChapterHead from '../../components/collect/ChapterHead.astro';
import Z from '../../i18n/zh/meta.json';
import '../../components/collect/collect.css';

const SECTIONS = [['new', '新增'], ['chg', '變更'], ['fix', '修正']] as const;
const entries = [...(Z.changelog as any[])].sort((a, b) => (a.d < b.d ? 1 : a.d > b.d ? -1 : 0));
---
<Base title="更新紀錄" description="PokéSurvivor 每次更新的內容，新的在上：新增、變更與修正。" chapter="log">
  <ChapterHead chapter="log" title="更新紀錄" summary="遊戲每次更新的內容，新的在上。沒有版本號（程式碼未明確），每一筆以更新日期標示。" />

  <ol class="tl">
    {entries.map(e => (
      <li>
        <p class="d"><time datetime={e.d}>{e.d}</time></p>
        <h2>{e.title}</h2>
        {SECTIONS.map(([k, label]) => e[k]?.length ? (
          <>
            <h3>{label}</h3>
            <ul>{e[k].map((t: string) => <li>{t}</li>)}</ul>
          </>
        ) : null)}
      </li>
    ))}
  </ol>

  <p class="src">內容為遊戲內「更新紀錄」的中文譯文，譯文由本站整理；日期與分項來自遊戲的 CHANGELOG 資料。</p>
</Base>

<style>
  .tl { list-style: none; margin: 40px 0 0; padding: 0 0 0 32px; border-left: 3px solid var(--ch); max-width: 820px; }
  .tl > li { position: relative; padding: 0 0 48px; }
  .tl > li::before {
    content: ''; position: absolute; left: -40px; top: 4px; width: 16px; height: 16px; border-radius: 50%;
    background: var(--paper); border: 4px solid var(--ch); box-sizing: border-box;
  }
  .d { margin: 0 0 4px; font: 800 14px var(--num); letter-spacing: .08em; color: var(--ch); }
  .tl h2 { font-size: 22px; margin: 0 0 6px; line-height: 1.3; }
  .tl h3 { font-size: 13px; font-weight: 800; letter-spacing: .08em; color: var(--ink-2); margin: 16px 0 4px; display: flex; align-items: center; gap: 8px; }
  .tl h3::before { content: ''; width: 8px; height: 8px; background: var(--ch); }
  .tl ul { margin: 0; padding-left: 1.3em; max-width: 72ch; }
  .tl ul > li { margin: .35em 0; }
  .tl ul > li::marker { color: var(--ch); }
  @media (max-width: 560px) {
    .tl { padding-left: 22px; }
    .tl > li::before { left: -32px; }
    .tl h2 { font-size: 19px; }
  }
</style>
