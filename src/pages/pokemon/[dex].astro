---
import Base from '../../layouts/Base.astro';
import Sprite from '../../components/Sprite.astro';
import Type from '../../components/Type.astro';
import Rarity from '../../components/Rarity.astro';
import Icon from '../../components/Icon.astro';
import {
  POKEMON, POKEMON_BY, TYPE_IDS, typeMult, typeName, movePool, MOVE_BY, KINDS, STAT_CARD, RANGE, step, pad, fmt, url,
  RARITY_NAME, genRegion, BEHAVIOR, BOSS_MOVE, ENEMY_TIERS, bossSlots, rescuable, mmss, traitName, type Pokemon,
} from '../../lib/game';

export function getStaticPaths() {
  return POKEMON.map(p => ({ params: { dex: String(p.dex) } }));
}
const p: Pokemon = POKEMON_BY[+Astro.params.dex];
const i = POKEMON.indexOf(p);
const prev = POKEMON[i - 1], next = POKEMON[i + 1];
const ANIM_ZH: Record<string, string> = { Idle: '待機', Walk: '移動', Attack: '攻擊', Shoot: '射擊', Charge: '蓄力', Hurt: '受傷', Faint: '倒下' };
const DIR_ZH = ['下', '右下', '右', '右上', '上', '左上', '左', '左下'];

// 能力值排名（同值同名次）
const rank = (k: 'hp' | 'spd' | 'atk' | 'bst') => 1 + POKEMON.filter(o => o[k] > p[k]).length;
const stats = [
  { k: 'hp' as const, zh: '生命', v: p.hp, note: '開場最大生命' },
  { k: 'spd' as const, zh: '速度', v: p.spd, note: '移動速度' },
  { k: 'atk' as const, zh: '攻擊倍率', v: p.atk, note: '所有招式傷害 ×' },
  { k: 'bst' as const, zh: '種族值總和', v: p.bst, note: '決定出場梯次與首領時段' },
];

// 受到各屬性攻擊的倍率
const defense = TYPE_IDS.map(t => ({ t, m: typeMult(t, p.types) }));
const groups = [...new Set(defense.map(d => +d.m.toFixed(3)))].sort((a, b) => b - a).map(m => ({ m, ts: defense.filter(d => +d.m.toFixed(3) === m).map(d => d.t) }));

const moves = movePool(p.types).map(id => MOVE_BY[id]).filter(Boolean);
const bosses = bossSlots(p);
const role = p.role;
const animData = p.sprite ? Object.fromEntries(Object.entries(p.sprite).map(([k, a]) => [k, {
  n: { src: url(`/sprites/${p.dex}/${a.src}.webp`), w: a.w, h: a.h, d: a.d },
  s: a.shiny ? { src: url(`/sprites/${p.dex}/s/${a.src}.webp`), w: a.w, h: a.h, d: a.d } : null,
}])) : null;
const idle = p.sprite?.Idle;
const scale = idle ? Math.max(3, Math.min(8, Math.floor(250 / Math.max(idle.w, idle.h)))) : 4;
const desc = `${p.zh}（${p.name}，No.${pad(p.dex)}）：${p.types.map(typeName).join('・')}屬性，生命 ${p.hp}、速度 ${p.spd}、攻擊倍率 ×${p.atk}，可學 ${moves.length} 招。`;
---
<Base title={`${p.zh} No.${pad(p.dex)}`} description={desc} chapter="pokemon">
  <nav class="crumbs" aria-label="位置">
    <span class="pn">
      {prev && <a href={url(`/pokemon/${prev.dex}/`)} rel="prev"><Icon name="arrowLeft" /><span class="num">{pad(prev.dex)}</span> {prev.zh}</a>}
      {next && <a href={url(`/pokemon/${next.dex}/`)} rel="next">{next.zh} <span class="num">{pad(next.dex)}</span><Icon name="arrowRight" /></a>}
    </span>
  </nav>

  <article class="spread">
    <header class="id">
      <p class="no num">No.{pad(p.dex)}</p>
      <h1>{p.zh}</h1>
      <p class="en">{p.name}</p>
      <div class="tags">
        {p.types.map(t => <Type t={t} />)}
        <span class="chip"><Rarity r={p.rarity} /> {RARITY_NAME[p.rarity]}</span>
        <span class="chip">{genRegion(p.gen)}</span>
        {p.starter && <span class="chip on">初始夥伴</span>}
        {p.leg && <span class="chip on">傳說</span>}
      </div>
    </header>

    <figure class="plate" data-plate data-anims={animData ? JSON.stringify(animData) : undefined}>
      <div class="stage halftone">
        <svg class="leaders" viewBox="0 0 400 300" preserveAspectRatio="none" aria-hidden="true">
          <path d="M200 150 L80 52 H18" pathLength="1" />
          <path d="M200 150 L330 70 H392" pathLength="1" />
          <path d="M200 160 L96 250 H18" pathLength="1" />
          <circle cx="200" cy="150" r="3" />
        </svg>
        <div class="callout c1"><span>生命</span><b class="num">{p.hp}</b></div>
        <div class="callout c2"><span>速度</span><b class="num">{p.spd}</b></div>
        <div class="callout c3"><span>攻擊</span><b class="num">×{p.atk}</b></div>
        <div class="fig"><Sprite dex={p.dex} scale={scale} /></div>
      </div>
      {animData && (
        <div class="controls">
          <div class="anims" role="radiogroup" aria-label="動作">
            {Object.keys(animData).map((k, n) => <button type="button" role="radio" aria-checked={n === 0 ? 'true' : 'false'} data-anim-btn={k}>{ANIM_ZH[k] ?? k}</button>)}
          </div>
          <div class="row2">
            <div class="dial" role="radiogroup" aria-label="方向">
              {DIR_ZH.map((d, n) => {
                const a = (90 - n * 45) * Math.PI / 180;
                return <button type="button" role="radio" aria-checked={n === 0 ? 'true' : 'false'} aria-label={`面向${d}`} data-dir-btn={n} style={`--x:${(Math.cos(a) * 34).toFixed(1)}px;--y:${(Math.sin(a) * 34).toFixed(1)}px;--r:${-n * 45}deg`}><i /></button>;
              })}
              <span class="dial-c" aria-hidden="true"><Icon name="rotate" /></span>
            </div>
            <div class="toggles">
              <button type="button" aria-pressed="false" data-shiny><Icon name="sparkle" />閃光</button>
              <button type="button" aria-pressed="false" data-spin><Icon name="rotate" />自動旋轉</button>
            </div>
          </div>
        </div>
      )}
      <figcaption>動畫與遊戲內相同（SpriteCollab 素材）。方向依遊戲順序：下、右下、右…左下。</figcaption>
    </figure>

    <section class="stats" aria-labelledby="h-stats">
      <h2 class="band" id="h-stats">能力值</h2>
      <div class="spec-wrap">
        <table class="spec">
          <thead><tr><th>項目</th><th class="r">數值</th><th>全圖鑑位置</th><th class="r">排名</th></tr></thead>
          <tbody>
            {stats.map(s => {
              const st = step(s.v, RANGE[s.k]);
              return (
                <tr>
                  <th>{s.zh}<small>{s.note}</small></th>
                  <td class="num">{s.k === 'atk' ? `×${s.v}` : s.v}</td>
                  <td class="bar"><span class:list={['ramp', `s${st}`]} style={`--p:${((s.v - RANGE[s.k][0]) / (RANGE[s.k][1] - RANGE[s.k][0])).toFixed(3)}`}><b /></span></td>
                  <td class="num rk">{rank(s.k)}<small>/{POKEMON.length}</small></td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
      <p class="fine">生命會再加上永久升級「活力」與局內能力卡；攻擊倍率乘在每一次招式傷害上。公式見<a href={url('/run/#能力值')}>冒險中・能力值</a>。</p>
    </section>
  </article>

  <section class="block" aria-labelledby="h-def">
    <h2 class="band" id="h-def">受到攻擊時的倍率</h2>
    <p class="lead">敵人的攻擊（與你的招式打在這隻寶可夢身上時）依屬性相剋相乘，結果夾在 ×0.3 到 ×2.4 之間。</p>
    <div class="def">
      {groups.map(g => (
        <div class:list={['dg', g.m > 1 ? 'hi' : g.m < 1 ? 'lo' : 'eq']}>
          <b class="num">×{fmt(g.m, 3)}</b>
          <div>{g.ts.map(t => <Type t={t} />)}</div>
        </div>
      ))}
    </div>
  </section>

  <section class="block" aria-labelledby="h-moves">
    <h2 class="band" id="h-moves">可學招式 <span class="num count">{moves.length}</span></h2>
    <p class="lead">升級選卡時，新招式只會從這個招式池出現：一般系的 8 招，加上{p.types.map(typeName).join('、')}屬性的招式。{p.starter && p.start && <>作為初始夥伴時，開場就帶著<a href={url(`/moves/${p.start}/`)}>{MOVE_BY[p.start]?.zh}</a>。</>}</p>
    <div class="spec-wrap">
      <table class="spec">
        <thead><tr><th>招式</th><th>屬性</th><th>類型</th><th class="r">Lv1 傷害</th><th class="r">Lv1 冷卻</th><th>Lv5 進化</th><th>進化需要</th></tr></thead>
        <tbody>
          {moves.map(m => (
            <tr>
              <th><a href={url(`/moves/${m.id}/`)}>{m.zh}</a>{p.start === m.id && <span class="mini">開場</span>}</th>
              <td><Type t={m.type} /></td>
              <td>{KINDS[m.kind]?.name ?? m.kind}</td>
              <td class="num">{m.levels[0].stats.dmg != null ? fmt(m.levels[0].stats.dmg) : '—'}</td>
              <td class="num">{m.levels[0].stats.cd != null ? `${fmt(m.levels[0].stats.cd)} 秒` : '—'}</td>
              <td>{m.evo ? (m.evoZh ?? m.evo.name) : '—'}</td>
              <td>{m.evo ? `${STAT_CARD[m.evo.needs] ?? m.evo.needs}卡` : '—'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="block" aria-labelledby="h-get">
    <h2 class="band" id="h-get">取得方式</h2>
    <ul class="ways">
      <li class:list={{ off: !p.gacha }}><b>扭蛋</b>{p.gacha ? <span>{genRegion(p.gen)}卡池・{RARITY_NAME[p.rarity]}（{p.rarity} 星）</span> : <span>沒有動畫圖，不在任何卡池</span>}</li>
      <li class:list={{ off: !p.starter }}><b>初始夥伴</b><span>{p.starter ? `開帳號時可選${p.traits ? `；性格測驗特質：${p.traits.map(traitName).join('、')}` : ''}` : '不是初始夥伴'}</span></li>
      <li class:list={{ off: !rescuable(p) }}><b>救援事件</b><span>{rescuable(p) ? '可能成為隨機事件「迷路的寶可夢」的救援對象' : '不會出現在救援事件（限 3 星以下、非傳說、不會飄浮）'}</span></li>
      <li class:list={{ off: !role.tiers.length }}><b>野生閃光</b><span>{role.tiers.length ? '野生出現時有 1/4096 機率是閃光，擊倒即收服閃光版' : '不會以野生敵人身分出現'}</span></li>
      <li class:list={{ off: !p.leg }}><b>裂隙</b><span>{p.leg ? '裂隙競技場的傳說寶可夢（閃光機率 1/512）' : '不是裂隙傳說'}</span></li>
    </ul>
  </section>

  <section class="block" aria-labelledby="h-foe">
    <h2 class="band" id="h-foe">作為敵人</h2>
    <div class="foe">
      <div class="beh">
        <p class="bname"><span>行為</span><b>{BEHAVIOR[role.behavior]?.name ?? role.behavior}</b>{role.hovers && <em>飄浮</em>}</p>
        <p>{BEHAVIOR[role.behavior]?.desc}</p>
        {role.hovers && <p>飄浮的寶可夢不受水、沼澤、岩漿等液體地形影響。</p>}
        <p class="fine">行為由編號決定，每一場都相同。<a href={url('/enemies/#敵人行為')}>所有行為說明</a></p>
      </div>
      <div class="foe-tables">
        {role.tiers.length > 0 ? (
          <div class="spec-wrap">
            <table class="spec">
              <caption>野生出現的梯次</caption>
              <thead><tr><th>梯次</th><th class="r">開始</th><th class="r">生命</th><th class="r">速度</th><th class="r">傷害</th><th class="r">經驗</th>{role.tiers.some((t: any) => t.shotDmg) && <><th class="r">射擊傷害</th><th class="r">間隔</th><th class="r">射程</th></>}</tr></thead>
              <tbody>
                {role.tiers.map((t: any) => (
                  <tr><th class="num">第 {t.tier + 1} 梯</th><td class="num">{mmss(ENEMY_TIERS[t.tier].from)}</td><td class="num">{t.hp}</td><td class="num">{t.spd}</td><td class="num">{t.dmg}</td><td class="num">{t.xp}</td>
                  {role.tiers.some((x: any) => x.shotDmg) && <><td class="num">{t.shotDmg ?? '—'}</td><td class="num">{t.shotCd ? `${t.shotCd} 秒` : '—'}</td><td class="num">{t.range ?? '—'}</td></>}</tr>
                ))}
              </tbody>
            </table>
          </div>
        ) : <p class="none">{p.leg ? '傳說寶可夢不會以一般敵人身分出現。' : p.rarity >= 5 ? '5 星寶可夢不會以一般敵人身分出現。' : '種族值總和不在任何梯次的範圍內，不會以一般敵人身分出現。'}</p>}
        {bosses.length > 0 && (
          <div class="spec-wrap">
            <table class="spec">
              <caption>可能成為的首領</caption>
              <thead><tr><th>出現</th><th class="r">生命</th><th class="r">速度</th><th class="r">傷害</th><th class="r">經驗</th></tr></thead>
              <tbody>
                {bosses.map(b => <tr><th class="num">{mmss(b.at)}</th><td class="num">{b.hp}</td><td class="num">{b.spd}</td><td class="num">{b.dmg}</td><td class="num">{b.xp}</td></tr>)}
              </tbody>
            </table>
          </div>
        )}
        {bosses.length > 0 && (() => { const ai = bosses[0].ai; return (
          <p class="boss-ai">當首領時：開場{ai.far ? '偏好保持距離（65%）' : '偏好近身（65%）'}，生命低於一半會暴怒（速度 ×1.15、出招更快）。近身招式：{ai.melee.map(m => BOSS_MOVE[m]).join('、')}；遠距離招式：{ai.ranged.map(m => BOSS_MOVE[m]).join('、')}。<a href={url('/enemies/#首領的招式')}>首領招式說明</a></p>
        ); })()}
        <p class="fine">表中為基礎值；實際數值會隨時間與玩家人數成長，見<a href={url('/enemies/#敵人強度成長')}>敵人強度成長</a>。</p>
      </div>
    </div>
  </section>
</Base>

<script>
  import '../../scripts/plate.ts';
</script>

<style>
  .crumbs { display: flex; justify-content: flex-end; align-items: center; gap: 12px; padding: 16px 0 0; font-size: 13.5px; font-weight: 700; }
  .crumbs > a { text-decoration: none; color: var(--ch); }
  .pn { display: flex; gap: 18px; }
  .pn a { display: inline-flex; align-items: center; gap: 6px; text-decoration: none; color: var(--ink-2); }
  .pn a:hover { color: var(--ink); }
  .pn :global(svg) { width: 16px; height: 16px; }
  .pn .num { color: var(--ink-3); }

  .spread { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); grid-template-areas: 'id id' 'plate stats'; gap: 24px 40px; margin-top: 18px; }
  .id { grid-area: id; display: grid; grid-template-columns: auto 1fr; align-items: end; column-gap: 20px; border-bottom: 4px solid var(--ch); padding-bottom: 14px; }
  .no { grid-row: 1 / span 2; margin: 0; font-size: clamp(56px, 9vw, 112px); font-weight: 800; line-height: .8; color: var(--ch); letter-spacing: -.01em; }
  h1 { font-size: clamp(32px, 5vw, 56px); line-height: 1; letter-spacing: .04em; }
  .en { margin: 4px 0 0; font: 700 18px var(--num); letter-spacing: .06em; color: var(--ink-2); }
  .tags { grid-column: 1 / -1; display: flex; flex-wrap: wrap; gap: 8px; margin-top: 14px; align-items: center; }
  .chip { display: inline-flex; align-items: center; gap: 6px; height: 24px; padding: 0 10px; font-size: 12.5px; font-weight: 700; border: 1.5px solid var(--ink); border-radius: 3px; }
  .chip.on { background: var(--sel); color: #151515; border-color: #151515; }

  .plate { grid-area: plate; margin: 0; }
  .stage { position: relative; aspect-ratio: 4 / 3; border: 2px solid var(--ink); background-color: var(--paper); overflow: hidden; }
  .stage { background-size: 9px 9px; }
  .stage::before { content: ''; position: absolute; inset: 0; background: radial-gradient(circle at 50% 52%, var(--paper) 30%, color-mix(in oklab, var(--paper) 55%, transparent) 75%); }
  .fig { position: absolute; inset: 0; display: grid; place-items: center; }
  .leaders { position: absolute; inset: 0; width: 100%; height: 100%; }
  .leaders path { fill: none; stroke: var(--ink); stroke-width: 1.2; vector-effect: non-scaling-stroke; stroke-dasharray: 1; stroke-dashoffset: 1; animation: draw 1.1s var(--ease) .25s forwards; }
  .leaders path:nth-child(2) { animation-delay: .4s; } .leaders path:nth-child(3) { animation-delay: .55s; }
  .leaders circle { fill: var(--ch); }
  @keyframes draw { to { stroke-dashoffset: 0; } }
  .callout { position: absolute; display: flex; flex-direction: column; line-height: 1; animation: pop .7s var(--ease) both; background: var(--paper); padding: 4px 6px; }
  .callout span { font-size: 11.5px; font-weight: 700; letter-spacing: .1em; color: var(--ink-2); }
  .callout b { font-size: 30px; font-weight: 800; color: var(--ink); }
  .c1 { left: 4.5%; top: 6%; animation-delay: .9s; } .c2 { right: 3%; top: 12%; text-align: right; animation-delay: 1.05s; } .c3 { left: 4.5%; bottom: 7%; animation-delay: 1.2s; }
  @keyframes pop { from { transform: translateY(8px); } to { transform: none; } }

  .controls { display: grid; gap: 12px; margin-top: 12px; }
  .anims { display: flex; flex-wrap: wrap; gap: 0; border: 2px solid var(--ink); border-radius: 4px; overflow: hidden; }
  .anims button { flex: 1 1 auto; min-width: 52px; height: 36px; font: 700 13.5px var(--font); color: var(--ink); background: var(--paper); border: 0; border-right: 1px solid var(--rule); cursor: pointer; transition: background .2s var(--ease); }
  .anims button:last-child { border-right: 0; }
  .anims button:hover { background: var(--paper-2); }
  .anims button[aria-checked='true'] { background: var(--ink); color: var(--paper); }
  .row2 { display: flex; align-items: center; gap: 20px; }
  .dial { position: relative; width: 96px; height: 96px; flex: none; border-radius: 50%; border: 1.5px solid var(--rule); }
  .dial button { position: absolute; left: 50%; top: 50%; width: 26px; height: 26px; margin: -13px; transform: translate(var(--x), var(--y)); border: 0; border-radius: 50%; background: transparent; cursor: pointer; display: grid; place-items: center; }
  .dial button i { width: 0; height: 0; border-left: 6px solid transparent; border-right: 6px solid transparent; border-top: 10px solid var(--ink-3); transform: rotate(var(--r)); transition: border-color .2s var(--ease), transform .2s var(--ease); }
  .dial button:hover i { border-top-color: var(--ink); }
  .dial button[aria-checked='true'] { background: var(--sel); }
  .dial button[aria-checked='true'] i { border-top-color: #151515; }
  .dial-c { position: absolute; inset: 0; display: grid; place-items: center; color: var(--ink-3); pointer-events: none; }
  .dial-c :global(svg) { width: 20px; height: 20px; }
  .toggles { display: flex; flex-wrap: wrap; gap: 8px; }
  .toggles button { display: inline-flex; align-items: center; gap: 6px; height: 36px; padding: 0 14px; font: 700 13.5px var(--font); color: var(--ink); background: var(--paper); border: 2px solid var(--ink); border-radius: 4px; cursor: pointer; }
  .toggles button :global(svg) { width: 16px; height: 16px; }
  .toggles button[aria-pressed='true'] { background: var(--sel); color: #151515; border-color: #151515; }
  .toggles button:disabled { opacity: .4; cursor: not-allowed; }
  figcaption { margin-top: 10px; font-size: 12.5px; color: var(--ink-3); }

  .stats { grid-area: stats; }

  .count { font-size: 24px; font-weight: 800; color: #fff; }
  .stats th small { display: block; font-weight: 400; font-size: 12px; color: var(--ink-3); }
  .stats td.bar { width: 42%; vertical-align: middle; }
  .rk small { font-size: 12px; color: var(--ink-3); font-weight: 600; }
  .fine { font-size: 12.5px; color: var(--ink-3); margin: 10px 0 0; }

  .block { margin-top: 56px; }
  .lead { color: var(--ink-2); margin-bottom: 14px; }
  .def { display: grid; gap: 0; border-top: 3px solid var(--ch); }
  .dg { display: grid; grid-template-columns: 92px 1fr; align-items: center; gap: 12px; padding: 9px 0; border-bottom: 1px solid var(--rule); }
  .dg > b { font-size: 24px; font-weight: 800; }
  .dg.hi > b { color: var(--ch); } .dg.lo > b { color: var(--ink-3); }
  .dg > div { display: flex; flex-wrap: wrap; gap: 6px; }
  .mini { margin-left: 6px; font-size: 11px; font-weight: 700; background: var(--sel); color: #151515; padding: 1px 6px; border-radius: 2px; }

  .ways { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 0; border-top: 3px solid var(--ch); }
  .ways li { display: grid; gap: 2px; padding: 12px 14px 12px 0; border-bottom: 1px solid var(--rule); }
  .ways li b { font-size: 15px; display: flex; align-items: center; gap: 8px; }
